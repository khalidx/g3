#!/usr/bin/env bash
set -eou pipefail

check_command_exists () {
  local name="$1"
  if ! command -v "$name" >/dev/null 2>&1; then
    return 1
  fi
}

check_command_exists "bun" || (
  check_command_exists "npm" || (
    echo "Neither bun nor npm (node) found; please install one of these to use the g3 CLI."
    exit 1
  )
  echo "bun not found; installing via npm..."
  npm install -g bun
)

bun run "$(dirname "$0")/../src/index.ts" -- "$@"
